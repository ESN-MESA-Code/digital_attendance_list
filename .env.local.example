NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Workspace domain allowed to sign in to the organiser dashboard
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=esnmesa.org

# Executives: members of this Google Workspace group see the names on closed
# lists (README, "Executives group"). Read with a service account.
EXECUTIVES_GROUP=board@esnmesa.org
GOOGLE_SERVICE_ACCOUNT_EMAIL=attendance-groups@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Only with domain-wide delegation: a Workspace admin to impersonate
GOOGLE_ADMIN_SUBJECT=
# Vercel Cron sends it to /api/cron/sync-executives (any long random string)
CRON_SECRET=
